; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[addons]

ss2d/version="3.3.1"

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Volcano-a-go-go"
run/main_scene="uid://43330p8bmmr2"
config/features=PackedStringArray("4.5", "Forward Plus")
run/max_fps=120
config/icon="res://icon.svg"

[autoload]

GeneralUtils="*res://utils/general_utils.gd"
ItemsDb="*res://autoload/items_db.gd"
Events="*res://autoload/events.gd"
Effects="*res://autoload/effects.gd"
NetworkGateway="*res://networking/NetworkGateway.gd"
NetManager="*res://networking/NetManager.gd"
AudioDb="*res://audio/audio_db.gd"
AudioManager="*res://audio/audio_manager.gd"
SettingsManager="*res://autoload/settings_manager.gd"
DynamicObjectsDb="*res://autoload/dynamic_objects_db.gd"

[display]

window/size/viewport_width=800
window/size/viewport_height=600
window/size/initial_position_type=3
window/size/resizable=false

[editor_plugins]

enabled=PackedStringArray("res://addons/rmsmartshape/plugin.cfg")

[file_customization]

folder_colors={
"res://UI/": "purple",
"res://assets/": "green",
"res://utils/": "pink"
}

[global_group]

lava-bodies=""
moving_platforms=""
metaball_platforms=""
one_way_platforms=""

